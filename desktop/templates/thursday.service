[Unit]
Description=Thursday desktop assistant
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@REPO_SYSTEMD@
ExecStart=@PYTHON_SYSTEMD@ -m assistant.main --web --no-browser
UMask=0077
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=78
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
