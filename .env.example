# Thursday — environment variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is gitignored and must never be committed.

# --- Web search (all optional; DuckDuckGo is used as a free fallback) ---

# Google Custom Search — https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Generic bearer-token search API (e.g. SearchAPI.io).
# Set both to enable; leave blank to skip.
SEARCH_API_KEY=
SEARCH_API_ENDPOINT=https://www.searchapi.io/api/v1/search
# Optional engine for SearchAPI.io (default: google). e.g. google_ai_mode
SEARCHAPI_ENGINE=google

# --- HenrikDev API (Valorant stats) ---
# Get a free key at https://docs.henrikdev.xyz/valorant/getting-started
HENRIKDEV_API_KEY=

# --- Local LLM (llama.cpp server) ---
# Host/port where your llama.cpp server is listening. The assistant talks to
# this OpenAI-compatible endpoint and overrides model.base_url in config.json.
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
# Path to the GGUF model file and the llama-server binary (used by
# run_vulkan_server.sh). ~ is expanded. Bring your own model.
MODEL_PATH=~/.models/your-model.gguf
LLAMA_SERVER_BIN=~/llama.cpp/build/bin/llama-server
# GPU layers / context / threads passed to llama-server.
LLAMA_NGL=70
LLAMA_CTX=8192
LLAMA_THREADS=6

# --- Thursday web/CLI server ---
# Host/port for the built-in HTTP+SSE server that serves the web UI.
THURSDAY_HOST=127.0.0.1
THURSDAY_PORT=5005
