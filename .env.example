# Thursday — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# .env is gitignored and must never be committed.

# =============================================================================
# IDENTITY
# =============================================================================
THURSDAY_USER_NAME=User

# =============================================================================
# LLM PROVIDER — pick ONE mode
# =============================================================================
# Mode A: Local llama.cpp (default, private, no API cost)
LLM_PROVIDER=local
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
# Path to GGUF + llama-server binary (used by run_vulkan_server.sh)
MODEL_PATH=~/.models/your-model.gguf
LLAMA_SERVER_BIN=~/llama.cpp/build/bin/llama-server
LLAMA_NGL=70
LLAMA_CTX=8192
LLAMA_THREADS=6

# Mode B: Cloud OpenAI-compatible API (no local GPU needed)
# Uncomment ONE provider and set its key. Then set:
#   LLM_PROVIDER=openai   # or openrouter | groq | together | deepseek | mistral | custom
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=sk-...
#
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# LLM_API_KEY=                 # generic fallback for custom / any provider
# LLM_BASE_URL=                # optional override, e.g. https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=2048
# LLM_TIMEOUT_SEC=90
# LLM_CONTEXT_BUDGET=100000

# =============================================================================
# THURSDAY SERVER
# =============================================================================
THURSDAY_HOST=127.0.0.1
THURSDAY_PORT=5005
# Optional shared secret for mutating APIs (message, confirm, shutdown, …)
# THURSDAY_API_TOKEN=
# Required if binding to 0.0.0.0 / LAN:
# THURSDAY_ALLOW_REMOTE=0

# =============================================================================
# SAFETY / POWER USER (optional)
# =============================================================================
# THURSDAY_ALLOW_SHELL=true
# THURSDAY_UNRESTRICTED_PATHS=0
# THURSDAY_READ_ROOTS=~,.
# THURSDAY_WRITE_ROOTS=.,~/Documents
# THURSDAY_MAX_TOOL_STEPS=6
# THURSDAY_SMART_TOOLS=1
# THURSDAY_TOOL_GROUPS=        # e.g. files,web,media — empty = smart filter

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================
# Web search (DuckDuckGo is free fallback if these are blank)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SEARCH_API_KEY=
SEARCH_API_ENDPOINT=https://www.searchapi.io/api/v1/search
SEARCHAPI_ENGINE=google

# Valorant stats — https://docs.henrikdev.xyz/
HENRIKDEV_API_KEY=

# Gmail IMAP (use an App Password — never your real password)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
